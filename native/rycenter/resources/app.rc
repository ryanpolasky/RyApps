#include <windows.h>
#include "resource.h"
#pragma code_page(65001)

IDI_APP ICON "app.ico"
1 RT_MANIFEST "app.manifest"

IDD_SETTINGS DIALOGEX 0, 0, 280, 196
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "RyCenter"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "A little more centered.", -1, 14, 12, 252, 12
    LTEXT "Center the active window on its current monitor.", -1, 14, 29, 252, 12
    LTEXT "Shortcut", -1, 14, 51, 54, 12
    PUSHBUTTON "", IDC_HOTKEY, 72, 48, 144, 18
    PUSHBUTTON "Reset", IDC_RESET, 222, 48, 44, 18
    CONTROL "Center new app windows automatically", IDC_AUTO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 78, 252, 12
    CONTROL "Start with Windows", IDC_STARTUP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 98, 252, 12
    LTEXT "Free. Offline. No ads or telemetry.\nRyCenter 0.1.0 | apps.ryanpolasky.com", -1, 14, 121, 252, 24
    LTEXT "Click the shortcut to record. Escape cancels recording.", IDC_STATUS, 14, 150, 252, 22
    DEFPUSHBUTTON "Save", IDOK, 158, 174, 52, 16
    PUSHBUTTON "Cancel", IDCANCEL, 216, 174, 50, 16
END

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Ryan Polasky"
            VALUE "FileDescription", "RyCenter — a little more centered"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "RyCenter"
            VALUE "LegalCopyright", "Copyright © 2026 Ryan Polasky. MIT License."
            VALUE "OriginalFilename", "RyCenter.exe"
            VALUE "ProductName", "RyCenter"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
